<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#E8192C">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thực đơn"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnRanking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="🏆"
            android:textSize="26sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="🍔"
            android:textSize="28sp"/>
    </LinearLayout>

    <!-- SEARCH BAR THẬT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/edtSearchMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Tìm món ăn..."
            android:textColorHint="@color/gray_500"
            android:textColor="@color/gray_900"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"/>

    </LinearLayout>

    <!-- CATEGORY -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btnAll"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="Tất cả"
                android:textColor="#E8192C"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnCatNuong"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🍢 Nướng &amp; Xiên que"
                android:textColor="#333333"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/btnCatChien"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🍗 Chiên &amp; Rán giòn"
                android:textColor="#333333"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/btnCatTron"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🥗 Trộn &amp; Chua cay giải ngấy"
                android:textColor="#333333"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/btnCatNoNhe"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🍞 No nhẹ &amp; Tinh bột"
                android:textColor="#333333"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/btnCatSinhTo"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🥤 Sinh tố &amp; Nước mát"
                android:textColor="#333333"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/btnCatTra"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🍵 Trà &amp; Đá xay"
                android:textColor="#333333"
                android:textSize="13sp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- MENU LIST -->
    <TextView
        android:id="@+id/txtCategoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tất cả món ăn"
        android:textColor="@color/gray_900"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFood"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_food" />

</LinearLayout>