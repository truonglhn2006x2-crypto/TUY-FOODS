<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xin chào 👋"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnCartIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="🛒"
                android:textSize="22sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📍 Giao đến: 45 Lê Lợi, Phường 4, TP. Tuy Hòa  ▾"
            android:textColor="#FFE3E5"
            android:textSize="13sp"/>

        <!-- SEARCH BAR THẬT: gõ chữ rồi bấm nút tìm kiếm trên bàn phím để tìm -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_box"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/iconSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/edtHomeSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Tìm món ăn, nhà hàng..."
                android:textColorHint="@color/gray_500"
                android:textColor="@color/gray_900"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"/>

        </LinearLayout>

    </LinearLayout>

    <!-- NỘI DUNG TĨNH: BANNER + DANH MỤC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- BANNER TRƯỢT TỰ ĐỘNG -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="14dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/dotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh mục"
                android:textColor="@color/gray_900"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnSeeAllCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem tất cả"
                android:textColor="@color/red_primary"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- DANH MỤC MÓN ĂN: cuộn ngang, 6 danh mục -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnCatNuong"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="@color/cat_yellow"
                        android:gravity="center"
                        android:text="🍢"
                        android:textSize="26sp"/>

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Nướng &amp; Xiên que"
                        android:textColor="@color/gray_700"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCatChien"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="@color/cat_orange"
                        android:gravity="center"
                        android:text="🍗"
                        android:textSize="26sp"/>

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Chiên &amp; Rán giòn"
                        android:textColor="@color/gray_700"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCatTron"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="@color/cat_red"
                        android:gravity="center"
                        android:text="🥗"
                        android:textSize="26sp"/>

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Trộn &amp; Chua cay"
                        android:textColor="@color/gray_700"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCatNoNhe"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="@color/cat_blue"
                        android:gravity="center"
                        android:text="🍞"
                        android:textSize="26sp"/>

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="No nhẹ &amp; Tinh bột"
                        android:textColor="@color/gray_700"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCatSinhTo"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="@color/cat_purple"
                        android:gravity="center"
                        android:text="🥤"
                        android:textSize="26sp"/>

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Sinh tố &amp; Nước mát"
                        android:textColor="@color/gray_700"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCatTra"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="@color/cat_green"
                        android:gravity="center"
                        android:text="🍵"
                        android:textSize="26sp"/>

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Trà &amp; Đá xay"
                        android:textColor="@color/gray_700"
                        android:textSize="11sp"/>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- TÍNH NĂNG KHÁC: chỉ còn Tự custom (đã bỏ Đơn hàng) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:id="@+id/btnCustomFood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_category_icon"
                    android:backgroundTint="@color/cat_purple"
                    android:gravity="center"
                    android:text="🧑‍🍳"
                    android:textSize="26sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tự custom"
                    android:textColor="@color/gray_700"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- BẢNG XẾP HẠNG: hiện ngay ở trang chủ, không cần bấm vào đâu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏆 Bảng xếp hạng bán chạy"
                android:textColor="@color/gray_900"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem tất cả"
                android:textColor="@color/red_primary"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPopular"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"/>

</LinearLayout>