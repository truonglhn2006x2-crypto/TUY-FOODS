<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F7F7F7">

    <!-- HEADER -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#E8192C">

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thực đơn"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍔"
                android:textSize="28sp" />

    </LinearLayout>


    <!-- CATEGORY -->
    <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:background="#FFFFFF"
            android:scrollbars="none">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">


            <!-- TẤT CẢ -->
            <LinearLayout
                    android:id="@+id/btnAll"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="#F2F2F2"
                        android:gravity="center"
                        android:text="🍽️"
                        android:textSize="26sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Tất cả"
                        android:textColor="#E8192C"
                        android:textSize="10sp"
                        android:textStyle="bold" />

            </LinearLayout>


            <!-- MÓN NƯỚNG -->
            <LinearLayout
                    android:id="@+id/btnGrillCategory"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="#FFF0D6"
                        android:gravity="center"
                        android:text="🍢"
                        android:textSize="26sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Món nướng&#10;&amp; Xiên que"
                        android:textColor="#555555"
                        android:textSize="10sp"
                        android:textAlignment="center" />

            </LinearLayout>


            <!-- MÓN CHIÊN -->
            <LinearLayout
                    android:id="@+id/btnFriedCategory"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="#FFE4D6"
                        android:gravity="center"
                        android:text="🍗"
                        android:textSize="26sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Món chiên&#10;&amp; Rán giòn"
                        android:textColor="#555555"
                        android:textSize="10sp"
                        android:textAlignment="center" />

            </LinearLayout>


            <!-- MÓN TRỘN -->
            <LinearLayout
                    android:id="@+id/btnSpicyCategory"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="#FFE1E4"
                        android:gravity="center"
                        android:text="🥗"
                        android:textSize="26sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Trộn &amp;&#10;Chua cay"
                        android:textColor="#555555"
                        android:textSize="10sp"
                        android:textAlignment="center" />

            </LinearLayout>


            <!-- MÓN NO NHẸ -->
            <LinearLayout
                    android:id="@+id/btnStarchCategory"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="#E5F0FF"
                        android:gravity="center"
                        android:text="🍞"
                        android:textSize="26sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Món no nhẹ&#10;&amp; Tinh bột"
                        android:textColor="#555555"
                        android:textSize="10sp"
                        android:textAlignment="center" />

            </LinearLayout>


            <!-- SINH TỐ -->
            <LinearLayout
                    android:id="@+id/btnSmoothieCategory"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="#E8E1FF"
                        android:gravity="center"
                        android:text="🥤"
                        android:textSize="26sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Sinh tố &amp;&#10;Nước mát"
                        android:textColor="#555555"
                        android:textSize="10sp"
                        android:textAlignment="center" />

            </LinearLayout>


            <!-- TRÀ -->
            <LinearLayout
                    android:id="@+id/btnTeaCategory"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_category_icon"
                        android:backgroundTint="#E1F3E5"
                        android:gravity="center"
                        android:text="🍵"
                        android:textSize="26sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Trà &amp;&#10;Đá xay"
                        android:textColor="#555555"
                        android:textSize="10sp"
                        android:textAlignment="center" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- TIÊU ĐỀ DANH MỤC -->
    <TextView
            android:id="@+id/txtCategoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="Tất cả món"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#F7F7F7" />


    <!-- DANH SÁCH MÓN -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMenu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:background="#F7F7F7" />

</LinearLayout>