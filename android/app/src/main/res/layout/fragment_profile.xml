<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="HỒ SƠ CỦA TÔI"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Tên khách hàng"
            android:textColor="#222222"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtMemberLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Hạng: Bình thường"
            android:textColor="#666666"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtTotalSpent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Tổng chi tiêu: 0đ"
            android:textColor="#333333"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtNextLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Còn 500.000đ để đạt hạng Tiềm năng"
            android:textColor="#666666"
            android:textSize="15sp"/>

        <ProgressBar
            android:id="@+id/progressMembership"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#E8192C"/>

        <TextView
            android:id="@+id/txtProgressPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="end"
            android:text="0%"
            android:textColor="#777777"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Quyền lợi đã mở"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtUnlockedBenefits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#E8F5E9"
            android:lineSpacingExtra="6dp"
            android:padding="16dp"
            android:text="✓ Hồ sơ thành viên"
            android:textColor="#1B5E20"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quyền lợi chưa mở"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtLockedBenefits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#EEEEEE"
            android:lineSpacingExtra="6dp"
            android:padding="16dp"
            android:text="🔒 Kho voucher thành viên"
            android:textColor="#666666"
            android:textSize="16sp"/>

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txtProfileError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Không thể tải thông tin thành viên"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnRetryProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="THỬ LẠI"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:text="ĐĂNG XUẤT"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>